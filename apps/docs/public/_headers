# Hashed build files never change, so browsers keep them for a year without
# asking again. Hosts that don't read _headers ignore this file.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Static output drops the route's Response headers, so the manifest's cache
# policy is set here instead.
/nimbus-api/coordinates.json
  Cache-Control: public, max-age=3600
